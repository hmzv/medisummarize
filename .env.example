# Copy this file to .env and replace placeholder values.
# Never commit a real .env file.

APP_NAME=MediSummarize AI
APP_ENV=development

# Required. Use a long random string for local development.
SECRET_KEY=replace-with-a-long-random-string

# Required. PostgreSQL is the intended datastore.
# Example (Docker Compose service in this repo):
# DATABASE_URL=postgresql+psycopg://medisummarize:medisummarize@localhost:5432/medisummarize
#
# Local SQLite is supported for tests and for first-run development when
# PostgreSQL credentials are not yet configured:
# DATABASE_URL=sqlite:///./data/runtime/medisummarize.dev.db
DATABASE_URL=postgresql+psycopg://medisummarize:medisummarize@localhost:5432/medisummarize

# Comma-separated browser origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT access-token lifetime in minutes (prototype default: 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Protected upload directory. Must not be served as static files.
STORAGE_DIR=./storage

# Upload limits for the prototype.
MAX_UPLOAD_BYTES=15728640
MAX_PDF_PAGES=50
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_SIDE=8000
MAX_TEXT_BYTES=2097152

# Run extraction after upload using in-process FastAPI BackgroundTasks.
# These jobs are not durable across process restarts.
EXTRACT_ON_UPLOAD=true

# Chunking / embeddings / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_PROVIDER=hashed_token
# hashed_token needs no download. sentence_transformers requires a model download
# (state size and license before fetching). Tests use test_hash.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
INDEX_DIR=./data/indexes
RETRIEVAL_TOP_K=8

# Generation. mock is labeled MOCK/TEST OUTPUT and is not a real-model result.
# For a local open-source model, install Ollama, pull a 7–8B instruct model,
# then set GENERATION_PROVIDER=openai_compatible.
GENERATION_PROVIDER=mock
GENERATION_BASE_URL=http://127.0.0.1:11434/v1
GENERATION_MODEL=llama3.1:8b
GENERATION_TIMEOUT_SECONDS=60
GENERATION_MAX_OUTPUT_TOKENS=800

# Frontend (optional). Empty string uses the Vite dev-server proxy.
VITE_API_BASE_URL=
